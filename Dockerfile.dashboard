FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_COLLECTOR_WS_URL
ENV VITE_COLLECTOR_WS_URL=$VITE_COLLECTOR_WS_URL
ARG VITE_READ_ONLY_DEMO=true
ENV VITE_READ_ONLY_DEMO=$VITE_READ_ONLY_DEMO
RUN npm run build

FROM nginx:alpine

ENV PORT=8080
EXPOSE 8080

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
