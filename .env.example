# ============================================================
# Frontend Environment Variables (Netlify / Vite Build)
# ============================================================

# URL of your deployed Render authentication backend service (e.g. https://telemetry-auth.onrender.com)
# Leave empty for local development (defaults to Vite proxy /api -> http://localhost:5000)
VITE_AUTH_API_URL=

# WebSocket URL of your telemetry collector service (e.g. wss://telemetry-collector.onrender.com)
# Defaults to ws://localhost:6001 when running locally
VITE_COLLECTOR_WS_URL=

# Set to true for read-only demo mode
VITE_READ_ONLY_DEMO=false
