# ============================================================
# Auth Service Environment Variables (Render / Local)
# ============================================================

# Port for the auth service (Render sets PORT automatically, defaults to 5000 locally)
PORT=5000

# Secret used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=change_this_secret_in_production

# Administrator credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$mggTnpQX9/lT2VYhduG7FOXExjvtWqis.feixlhaK.wBEc5OmXOdG
ADMIN_NAME=Admin
ADMIN_ROLE=Administrator
